# 遥感图像分类系统 - 环境变量示例
# 复制此文件为 .env 并修改相应值

# ========== 后端配置 ==========
# FastAPI 配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=false  # 生产环境设置为 false

# 模型路径配置
MODEL_PATH_PREFIX=/home/zhouh/biye/models
# 或者使用容器内的路径:
# MODEL_PATH_PREFIX=/app/models

# 数据路径配置
DATA_PATH_PREFIX=/home/zhouh/biye/data
# 或者使用容器内的路径:
# DATA_PATH_PREFIX=/app/data

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS 配置
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]
# 生产环境:
# CORS_ORIGINS=["https://your-domain.com"]

# ========== 前端配置 ==========
VITE_API_BASE_URL=http://localhost:8000/api/v1
# 生产环境:
# VITE_API_BASE_URL=/api/v1  # 使用相对路径，由反向代理处理

# ========== 数据库配置 (可选) ==========
# DATABASE_URL=postgresql://user:password@db:5432/remote_sensing
# REDIS_URL=redis://redis:6379/0

# ========== 性能配置 ==========
# 图像处理
MAX_IMAGE_SIZE_MB=10
BATCH_PREDICT_MAX_FILES=50

# 模型加载
MODEL_LOAD_TIMEOUT=30
MODEL_PREDICT_TIMEOUT=30